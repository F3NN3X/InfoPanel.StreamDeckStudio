{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "InfoPanel Studio",
	"Version": "0.2.0.0",
	"Author": "F3NN3X",
	"Description": "Control InfoPanel Studio from Stream Deck: switch pages and profiles, rotate pages, and show live sensor values.",
	"Category": "InfoPanel Studio",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"UUID": "com.f3nn3x.infopanel-studio",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"Actions": [
		{
			"Name": "Go to page",
			"UUID": "com.f3nn3x.infopanel-studio.go-to-page",
			"Icon": "imgs/actions/go-to-page/icon",
			"Tooltip": "Show a Studio page. The key lights up while that page is showing.",
			"PropertyInspectorPath": "ui/go-to-page.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/go-to-page/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Next page",
			"UUID": "com.f3nn3x.infopanel-studio.next-page",
			"Icon": "imgs/actions/next-page/icon",
			"Tooltip": "Show the next Studio page (wraps around).",
			"PropertyInspectorPath": "ui/next-page.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/next-page/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Previous page",
			"UUID": "com.f3nn3x.infopanel-studio.prev-page",
			"Icon": "imgs/actions/prev-page/icon",
			"Tooltip": "Show the previous Studio page (wraps around).",
			"PropertyInspectorPath": "ui/prev-page.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/prev-page/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Switch profile",
			"UUID": "com.f3nn3x.infopanel-studio.switch-profile",
			"Icon": "imgs/actions/switch-profile/icon",
			"Tooltip": "Force a Studio profile on the kiosks, or choose Auto to clear the override.",
			"PropertyInspectorPath": "ui/switch-profile.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/switch-profile/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Auto-rotate",
			"UUID": "com.f3nn3x.infopanel-studio.auto-rotate",
			"Icon": "imgs/actions/auto-rotate/icon",
			"Tooltip": "Press to toggle page rotation. Hold for one second to go back to the saved setting.",
			"PropertyInspectorPath": "ui/auto-rotate.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/auto-rotate/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Page cycler",
			"UUID": "com.f3nn3x.infopanel-studio.page-cycler",
			"Icon": "imgs/actions/page-cycler/icon",
			"Tooltip": "Turn the dial to move through Studio pages (Stream Deck +).",
			"PropertyInspectorPath": "ui/page-cycler.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/page-cycler.json",
				"Icon": "imgs/actions/page-cycler/icon",
				"StackColor": "#27272a",
				"TriggerDescription": {
					"Rotate": "Previous / next page",
					"Push": "First page",
					"Touch": "Toggle auto-rotate"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/page-cycler/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Sensor value",
			"UUID": "com.f3nn3x.infopanel-studio.sensor-value",
			"Icon": "imgs/actions/sensor-value/icon",
			"Tooltip": "Show a live InfoPanel sensor with warning colours and a sparkline. Optionally opens a page when pressed.",
			"PropertyInspectorPath": "ui/sensor-value.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/sensor-value/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Alerts",
			"UUID": "com.f3nn3x.infopanel-studio.alerts",
			"Icon": "imgs/actions/alerts/icon",
			"Tooltip": "Count of active InfoPanel Studio alerts. Press to acknowledge the newest, hold to dismiss it.",
			"PropertyInspectorPath": "ui/alerts.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/alerts/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Test alert",
			"UUID": "com.f3nn3x.infopanel-studio.test-alert",
			"Icon": "imgs/actions/test-alert/icon",
			"Tooltip": "Fire a test alert for a chosen rule to preview how it looks.",
			"PropertyInspectorPath": "ui/test-alert.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/test-alert/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Pause rotation",
			"UUID": "com.f3nn3x.infopanel-studio.pause-rotation",
			"Icon": "imgs/actions/pause-rotation/icon",
			"Tooltip": "Hold page rotation for a while (30 s, or the rotate period) while the profile is rotating.",
			"PropertyInspectorPath": "ui/pause-rotation.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/pause-rotation/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Coding agents",
			"UUID": "com.f3nn3x.infopanel-studio.agents",
			"Icon": "imgs/actions/agents/icon",
			"Tooltip": "Show whether Claude Code or Codex sessions need you or are working. Optionally opens a page when pressed.",
			"PropertyInspectorPath": "ui/agents.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/agents/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Sensor (dial)",
			"UUID": "com.f3nn3x.infopanel-studio.sensor-dial",
			"Icon": "imgs/actions/sensor-dial/icon",
			"Tooltip": "Show a live InfoPanel sensor with a bar on the touch strip (Stream Deck +). Press or touch opens a page.",
			"PropertyInspectorPath": "ui/sensor-dial.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/sensor-dial.json",
				"Icon": "imgs/actions/sensor-dial/icon",
				"StackColor": "#27272a",
				"TriggerDescription": {
					"Push": "Open page",
					"Touch": "Open page"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/sensor-dial/key",
					"TitleAlignment": "middle"
				}
			]
		}
	]
}