{
  "name": "infopanel-streamdeck-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "npm run icons && rollup -c",
    "watch": "npm run icons && rollup -c -w --watch.onEnd=\"streamdeck restart com.f3nn3x.infopanel-studio\"",
    "test": "npm run icons && vitest run",
    "typecheck": "npm run icons && tsc --noEmit",
    "validate": "streamdeck validate com.f3nn3x.infopanel-studio.sdPlugin --no-update-check",
    "pack": "streamdeck pack com.f3nn3x.infopanel-studio.sdPlugin"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "~24.1.0",
    "lucide-static": "^1.56.0",
    "rollup": "^4.64.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2"
  }
}
